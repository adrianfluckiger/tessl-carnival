{
  "name": "adrian-engineering/tessl-carnival",
  "mode": "managed",
  "dependencies": {
    "tessl-labs/factory-setup": {
      "version": "0.17.0"
    }
  },
  "agents": [
    "claude-code"
  ],
  "schedules": {
    "rule-mining": {
      "cron": "0 6 * * 1",
      "description": "Find mistakes code review keeps catching on pull requests and file issues proposing rules for them",
      "action": {
        "skill": "file:tessl-factory#rule-mining",
        "environment": "tessl-carnival-loops",
        "agent": "claude-code",
        "model": "claude-sonnet-5-5"
      }
    }
  }
}
